# ============================================================
#  TEMPLATE KONFIGURASI BOT MONITORING RE JATENG-DIY (.env.example)
#  Salin file ini menjadi `.env` lalu isi nilainya sesuai server.
#  File `.env` JANGAN di-commit ke Git!
# ============================================================

# ------------------------------------------------------------
# 1. TELEGRAM BOT & GRUP
# ------------------------------------------------------------
TOKEN=ISI_TOKEN_DARI_BOTFATHER
GROUP_ID=0
REPORT_GROUP_ID=0

# Daftar Chat ID yang diabaikan total (inbound receive-only), pisahkan dengan koma
BLOCKED_CHAT_IDS=

# ID masing-masing Topic di grup REPORT_GROUP_ID (kosongkan atau 0 untuk menonaktifkan)
TOPIC_SALES=0
TOPIC_COLLECTION=0
TOPIC_GTM=0
TOPIC_CAPS=0
TOPIC_PARTNERSHIP=0
TOPIC_FUNDAMENTAL=0
TOPIC_MARKET_SHARE=0

# Topic & flag fitur Stock ONT Alert (default mengikuti TOPIC_PARTNERSHIP)
STOCK_ALERT_TOPIC_ID=0
STOCK_ALERT_ENABLED=false

# ------------------------------------------------------------
# 2. PENGATURAN UMUM & JADWAL LAPORAN
# ------------------------------------------------------------
PRIMARY_HOST=
REPORT_TITLE=Hourly Monitoring RE IndiHome JATENG-DIY
REGION_NAME=JATENG-DIY

JADWAL_KIRIM_KE_GRUP_REPORT=false
JADWAL_CEK_DETIK=10
JADWAL_TUNGGU_MENIT=90
JADWAL_RETRY_BACKGROUND_JAM=6
JADWAL_MISFIRE_GRACE_S=1800
REPORT_TIMEOUT_MENIT=90

# Pengaturan mode query terjadwal: "langsung" | "rajawali" | "auto"
MODE_QUERY=langsung
RAJAWALI_TIMEOUT_MENIT=60
RAJAWALI_BLOK_INPUT=false

# ------------------------------------------------------------
# 3. DATABASE MYSQL UTAMA (RAJAWALI)
# ------------------------------------------------------------
DB_HOST=ISI_HOST_DB
DB_PORT=3306
DB_USER=ISI_USER_DB
DB_PASS=ISI_PASSWORD_DB
DB_NAME=ISI_NAMA_DB
DB_TABLE_PREFIX=dashboard_hourly_sales_
DB_REGION=JATENG

# ------------------------------------------------------------
# 4. DATABASE MYSQL KEDUA (INDIANA / PRANPC)
# ------------------------------------------------------------
DB2_HOST=ISI_HOST_DB2
DB2_PORT=3306
DB2_USER=ISI_USER_DB2
DB2_PASS=ISI_PASSWORD_DB2
DB2_NAME=indiana
DB2_REGIONAL=JATENG-DIY

# ------------------------------------------------------------
# 5. OTOMASI PRISMA & RAJAWALI DASHBOARD
# ------------------------------------------------------------
RAJAWALI_URL=https://rajawali.example.com/rajawali/worklist/dashboard
PRISMA_PIN=
RAJAWALI_USER=
RAJAWALI_PASS=

# ------------------------------------------------------------
# 6. KONFIGURASI FMC API (/liveupdateutoip)
# ------------------------------------------------------------
FMC_BASE_URL=https://fmc.example.com:3001
FMC_COOKIE=
FMC_XTOKEN=
FMC_VERIFY_SSL=false

# ------------------------------------------------------------
# 7. DASHBOARD JATENG GAYENG (/leads)
# ------------------------------------------------------------
JATENGGAYENG_BASE_URL=https://jatenggayeng.example.com
JATENGGAYENG_USER=ISI_USERNAME
JATENGGAYENG_PASS=ISI_PASSWORD

# ------------------------------------------------------------
# 8. WHATSAPP HTTP API (WAHA) & JADWAL WA
# ------------------------------------------------------------
WAHA_BASE_URL=https://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_TARGET_CHAT_ID=
WAHA_SEND_IMAGES=true
WA_JADWAL_OTOMATIS_AKTIF=true

# ------------------------------------------------------------
# 9. PENGATURAN PER REPORT SPESIFIK
# ------------------------------------------------------------
AGRESIF_KIRIM_KE_TOPIC=true
DJP_PRIORITY_MASTER_DIR=resources/djp_priority

MURMER_TARGET_JATENG_DIY=1275
MURMER_TARGET_JATIM=1443
MURMER_TARGET_JABAR=1804
MURMER_TARGET_EASTERN_JABOTABEK=1152
MURMER_PRODUCT_KEYWORD=murmer
MURMER_YTD_START_MONTH=5

CHILDPS_KIRIM_KE_GRUP=true
CHILDPS_SQL=

SF_TERITORY_URL=
